# Обязательные переменные
# Токен сообщества VK с правами messages и manage
VK_TOKEN=your_vk_group_token_here

# Peer ID группового чата (2000000000 + chat_id), например 2000000001
CHAT_PEER_ID=2000000001

# День недели сбора: 0=Пн, 1=Вт, ..., 6=Вс
COLLECT_WEEKDAY=2

# Время сбора в формате HH:MM (00:00–23:59)
COLLECT_TIME=10:00

# Напоминание перед сбором (опционально)
# REMIND_ENABLED=true — отправлять напоминание в заданный день/время
# REMIND_WEEKDAY — день недели напоминания (0=Пн, ..., 6=Вс)
# REMIND_TIME — время напоминания HH:MM
REMIND_ENABLED=true
REMIND_WEEKDAY=0
REMIND_TIME=08:00

# Администраторы (опционально)
# Список VK ID через запятую, например: 123456789,987654321
# Эти пользователи могут использовать админ-команды (очистить, удалить участника)
ADMIN_VK_IDS_RAW=

# Путь к JSON-файлу со списком участников.
# Локально — рядом с проектом. В Docker переопределяется через volume на /app/data/participants.json.
DATA_PATH=data.json
