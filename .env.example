# Обязательные переменные
# Токен сообщества VK с правами messages и manage
VK_TOKEN=your_vk_group_token_here

# Peer ID группового чата (2000000000 + chat_id), например 2000000001
CHAT_PEER_ID=2000000001

# День и время анонса: в этот момент открывается запись
COLLECT_WEEKDAY=0
COLLECT_TIME=08:00

# День и время начала тренировки: в этот момент запись закрывается
EVENT_WEEKDAY=1
EVENT_TIME=19:30

# Напоминание перед сбором (опционально)
# REMIND_ENABLED=true — отправлять напоминание в заданный день/время
# REMIND_WEEKDAY — день недели напоминания (0=Пн, ..., 6=Вс)
# REMIND_TIME — время напоминания HH:MM
# Напоминание отправляется только при открытой записи и не должно совпадать
# с анонсом или началом тренировки
REMIND_ENABLED=true
REMIND_WEEKDAY=1
REMIND_TIME=08:00

# Администраторы (опционально)
# Список положительных VK ID через запятую, например: 123456789,987654321
# Значение проверяется при старте; пустые элементы и нечисловые ID запрещены
# Эти пользователи могут очищать список, удалять участников и создавать события
ADMIN_VK_IDS_RAW=

# Путь к JSON-файлу со списком участников.
# Локально — рядом с проектом. В Docker переопределяется через volume на /app/data/participants.json.
# Компоненты пути ".." запрещены и вызовут ValidationError при старте.
DATA_PATH=data.json
